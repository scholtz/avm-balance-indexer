# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props AvmBalanceIndexer.slnx ./
COPY src/ src/
RUN dotnet restore src/AvmBalanceIndexer.Worker/AvmBalanceIndexer.Worker.csproj
RUN dotnet publish src/AvmBalanceIndexer.Worker/AvmBalanceIndexer.Worker.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/runtime:10.0 AS runtime
WORKDIR /app
ENV DOTNET_EnableDiagnostics=0
USER $APP_UID
COPY --from=build /app .
ENTRYPOINT ["dotnet", "AvmBalanceIndexer.Worker.dll"]
