<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>AvmBalanceIndexer.Client</PackageId>
    <Version>1.0.0</Version>
    <Authors>scholtz</Authors>
    <Description>.NET SDK for the AVM Balance Indexer: token balances, holders and history for Algorand, Algorand TestNet and Voi.</Description>
    <PackageTags>algorand;voi;avm;asa;arc200;arc20;indexer;balances;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/scholtz/avm-balance-indexer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/scholtz/avm-balance-indexer/tree/main/sdk/dotnet</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The generated client has no XML comments on everything. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../AGENTS.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
