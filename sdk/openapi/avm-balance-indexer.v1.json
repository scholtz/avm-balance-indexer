    "/v1/{chain}/tokens/{kind}/{tokenId}/holders/scans": {
      "post": {
        "tags": [
          "Scans"
        ],
        "summary": "Start an asynchronous export of every holder of a token at a round",
        "description": "Accepted at once; poll the scan and read the result pages. The body is optional: { \u0022round\u0022: 123, \u0022includeZero\u0022: false }.",
        "operationId": "CreateHolderScan",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "description": "The chain this deployment serves.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ChainId"
            },
            "example": "algorand-testnet"
          },
          {
            "name": "kind",
            "in": "path",
            "description": "Token kind: algo (native), asa (Algorand Standard Asset, also ARC-20) or arc200 (application token).",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TokenKind"
            }
          },
          {
            "name": "tokenId",
            "in": "path",
            "description": "Asset id, application id, or 0 for the native token.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
