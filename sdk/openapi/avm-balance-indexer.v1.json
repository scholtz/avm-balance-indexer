{
  "openapi": "3.0.4",
  "info": {
    "title": "AVM Balance Indexer API",
    "description": "Token balances, holders and history for Algorand-family chains (ALGO, ASA, ARC-20, ARC-200). Every deployment serves one chain under /v1/{chain}. Amounts and deltas are decimal strings; rounds are integers.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/v1/{chain}/status": {
      "get": {
        "tags": [
          "Status"
        ],
        "summary": "Indexed round, target round, lag and ingestion state",
        "operationId": "GetChainStatus",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "description": "The chain this deployment serves.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ChainId"
            },
            "example": "algorand-testnet"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/{chain}/accounts/{address}/tokens": {
      "get": {
        "tags": [
          "Balances"
        ],
        "summary": "Current token holdings of an account",
        "description": "Holdings ordered by token kind and id. Zero balances (opt-ins) are listed with includeZero=true. Page with nextCursor.",
        "operationId": "GetAccountTokens",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "description": "The chain this deployment serves.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ChainId"
            },
            "example": "algorand-testnet"
          },
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "includeZero",
            "in": "query",
            "description": "Also list accounts that are opted in but hold zero.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor from the previous page\u0027s nextCursor.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, 1 to 1000 (default 100).",
            "schema": {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HoldingsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/{chain}/accounts/{address}/tokens/{kind}/{tokenId}/balance": {
      "get": {
        "tags": [
          "Balances"
        ],
        "summary": "End-of-round balance of an account",
        "description": "The balance after the last effect at or before the round (default: the latest published round), including rounds without activity. An explicit published round is cacheable.",
        "operationId": "GetTokenBalance",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "description": "The chain this deployment serves.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ChainId"
            },
            "example": "algorand-testnet"
          },
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "path",
            "description": "Token kind: algo (native), asa (Algorand Standard Asset, also ARC-20) or arc200 (application token).",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TokenKind"
            }
          },
          {
            "name": "tokenId",
            "in": "path",
            "description": "Asset id, application id, or 0 for the native token.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint64"
            }
          },
          {
            "name": "round",
            "in": "query",
            "description": "Chain round (end-of-round state). Omit for the latest published round.",
            "schema": {
              "type": "integer",
              "format": "uint64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/{chain}/accounts/{address}/tokens/{kind}/{tokenId}/transactions": {
      "get": {
        "tags": [
          "History"
        ],
        "summary": "Balance effects of an account and token, newest first",
        "description": "Every change of the balance with its signed delta, the balance after it and the transaction it came from. Limit the range with fromRound and toRound.",
        "operationId": "GetTokenHistory",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "description": "The chain this deployment serves.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ChainId"
            },
            "example": "algorand-testnet"
          },
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "path",
            "description": "Token kind: algo (native), asa (Algorand Standard Asset, also ARC-20) or arc200 (application token).",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TokenKind"
            }
          },
          {
            "name": "tokenId",
            "in": "path",
            "description": "Asset id, application id, or 0 for the native token.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint64"
            }
          },
          {
            "name": "fromRound",
            "in": "query",
            "description": "Oldest round to include. Omit for no lower bound.",
            "schema": {
              "type": "integer",
              "format": "uint64"
            }
          },
          {
            "name": "toRound",
            "in": "query",
            "description": "Newest round to include. Omit for no upper bound.",
            "schema": {
              "type": "integer",
              "format": "uint64"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque cursor from the previous page\u0027s nextCursor.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, 1 to 1000 (default 100).",
            "schema": {
              "maximum": 1000,
              "minimum": 1,
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
