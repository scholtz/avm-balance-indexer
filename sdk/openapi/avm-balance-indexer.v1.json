    "/v1/{chain}/scans/{id}/holders": {
      "get": {
        "tags": [
          "Scans"
        ],
        "summary": "Result pages of a scan (also while it is running)",
        "description": "Without a nextCursor and with complete=false, repeat the same request a moment later.",
        "operationId": "GetHolderScanResult",
        "parameters": [
          {
            "name": "chain",
            "in": "path",
            "description": "The chain this deployment serves.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ChainId"
            },
