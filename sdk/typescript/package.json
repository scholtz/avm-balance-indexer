{
  "name": "@scholtz/avm-balance-indexer",
  "version": "1.0.1",
  "description": "TypeScript SDK for the AVM Balance Indexer: token balances, holders and history for Algorand, Algorand TestNet and Voi.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "keywords": ["algorand", "voi", "avm", "asa", "arc200", "arc20", "indexer", "balances", "sdk"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scholtz/avm-balance-indexer.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/scholtz/avm-balance-indexer/tree/main/sdk/typescript",
  "bugs": "https://github.com/scholtz/avm-balance-indexer/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/client.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2"
  }
}
