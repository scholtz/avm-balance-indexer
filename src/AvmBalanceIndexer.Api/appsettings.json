{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "Format": "Text"
  },
  "AllowedHosts": "*",
  "Chain": "algorand-testnet",
  "Storage": {
    "Provider": "PostgreSql",
    "PostgreSql": {
      "ConnectionString": "",
      "AccountHashPartitions": 64
    },
    "Cassandra": {
      "ContactPoints": [],
      "Keyspace": "avm_indexer",
      "LocalDatacenter": "dc1",
      "Username": "",
      "Password": ""
    }
  }
}
