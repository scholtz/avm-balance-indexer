{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Logging": {
    "Format": "Text"
  },
  "Chain": "algorand-testnet",
  "Storage": {
    "Provider": "PostgreSql",
    "PostgreSql": {
      "ConnectionString": "",
      "AccountHashPartitions": 64
    },
    "Cassandra": {
      "ContactPoints": [],
      "Keyspace": "avm_indexer",
      "LocalDatacenter": "dc1",
      "Username": "",
      "Password": ""
    }
  },
  "Algorand": {
    "AlgodUrl": "",
    "AlgodToken": "",
    "GossipHosts": [],
    "ExpectedGenesisHash": "",
    "MaxAttempts": 8,
    "RequestTimeout": "00:00:10"
  },
  "Indexer": {
    "FetchConcurrency": 128,
    "CommitBatchRounds": 25,
    "FollowPollInterval": "00:00:02",
    "BalanceCacheEntries": 500000
  }
}
